# --- Serveur
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000        # URL publique de l'API (https://api.whatstore.store en production)
JWT_SECRET=change-me-long-random-string # OBLIGATOIRE en production

# --- Base de données
# Vide = base embarquée PGlite (dev, sans installation). Avec DATABASE_URL = PostgreSQL.
DATABASE_URL=
PGLITE_DIR=./data                       # dossier de la base embarquée (vide = mémoire)

# --- Règles métier
COMMISSION_RATE=0.05
MIN_PAYOUT=1000
COUNTRY_CODE=229
ADMIN_PHONES=                           # ex: 2290197000000,2290196000000 (numéros admin)
ALLOW_SELF_PURCHASE=true                # false en production

RESERVATION_HOURS=24                  # durée d'une réservation en magasin

# --- SMS (code de connexion)
SMS_PROVIDER=console                    # console | webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
OTP_FIXED=123456                        # code fixe pour les tests (ignoré en production)

# --- Paiements
PAYMENT_PROVIDER=mock                   # mock | (ton adaptateur : voir src/payments.js)
ALLOW_MOCK_PAYMENTS=false               # true pour autoriser le faux paiement en production (déconseillé)
WEBHOOK_SECRET=                         # secret HMAC des webhooks de paiement
PAYMENT_POLL_MS=3000

# --- Fichiers
UPLOAD_DIR=./uploads                    # en production : préférer un stockage objet (S3/R2) derrière /media

# --- Liens profonds (fichiers .well-known)
ANDROID_PACKAGE=store.whatstore.whatstore
ANDROID_SHA256=
APPLE_APP_ID=                           # TEAMID.store.whatstore.whatstore
